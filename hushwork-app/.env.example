# Copy this file to .env.local and fill in the values. .env.local is never committed.
# Both Supabase values are public by design: the URL only says where the project is, and the publishable key
# identifies the project without granting power. The database rules (supabase/waitlist.sql and
# supabase/workflows.sql) decide what a visitor or a signed-in person may do. Never put a service_role or
# sb_secret_ key in a NEXT_PUBLIC_ variable or anywhere in this project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: the site's address once it has a domain, used for link previews.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional, SECRET. Lets "Preview plan" use an AI model run by Groq to write the plan. Without it the keyword preview is used.
# Server only: never put NEXT_PUBLIC_ in front of it. Get one at https://console.groq.com/keys (it starts with gsk_)
# GROQ_API_KEY=

# Optional, SECRET. Lets a "Look something up" step set to Linear read YOUR open Linear tasks after you press Approve on the
# Runs page (read-only). Server only: never put NEXT_PUBLIC_ in front of it. Get one in Linear: workspace name, Settings,
# Security & access, Personal API keys, New API key. It starts with lin_api_
# LINEAR_API_KEY=
